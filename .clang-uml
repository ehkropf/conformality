# Diagram file for Conformality
compilation_database_dir: build
output_directory: docs/diagrams
query_driver: c++
diagrams:
  conformal_map:
    type: class
    title: Conformal Map Depends
    generate_method_arguments: abbreviated
    glob:
      - src/**/*.h
      - src/**/*.cpp
    include:
      dependencies:
        - ConformalMap
      dependants:
        - ConformalMap
    exclude:
      namespaces:
        - std
    plantuml:
      before:
        - 'skinparam classAttributeIconSize 0'
        - 'skinparam classFontSize 12'
        - 'skinparam class {'
        - '  BackgroundColor White'
        - '  BorderColor Black'
        - '  ArrowColor Black'
        - '}'

  fornberg_mc:
    type: class
    title: Fornberg MC Method
    generate_method_arguments: abbreviated
    glob:
      - src/**/*.h
      - src/**/*.cpp
    include:
      context:
        - match:
            radius: 3
            pattern: FornbergMC
        - match:
            radius: 2
            pattern: PMatrixBuilder
        - match:
            radius: 2
            pattern: FornbergMCConfiguration
        - match:
            radius: 2
            pattern: FornbergCanonicalDomain
    exclude:
      namespaces:
        - std
        - Eigen
      elements:
        - IStatusManager
    plantuml:
      before:
        - 'skinparam classAttributeIconSize 0'
        - 'skinparam classFontSize 11'
        - 'skinparam class {'
        - '  BackgroundColor White'
        - '  BorderColor Black'
        - '  ArrowColor Black'
        - '}'

  numerics:
    type: class
    title: Numerical Utilities
    generate_method_arguments: abbreviated
    glob:
      - src/numerics/*.h
      - src/numerics/*.cpp
    include:
      elements:
        - FFTWWrapper
        - CGSolver
        - Grid
        - RootFinder
    exclude:
      namespaces:
        - std
        - Eigen
    plantuml:
      before:
        - 'skinparam classAttributeIconSize 0'
        - 'skinparam classFontSize 12'
        - 'skinparam class {'
        - '  BackgroundColor White'
        - '  BorderColor Black'
        - '  ArrowColor Black'
        - '}'

  domains:
    type: class
    title: Available Domains
    generate_method_arguments: abbreviated
    glob:
      - src/domains/*.h
      - src/domains/*.cpp
    include:
      context:
        - match:
            radius: 4
            pattern: Domain
    exclude:
      namespaces:
        - std
      elements:
        - IStatusManager

  all_classes:
    type: class
    title: All Conformality Classes
    generate_method_arguments: abbreviated
    glob:
      - src/**/*.h
      - src/**/*.cpp
    exclude:
      namespaces:
        - std

# vim: ft=yaml
