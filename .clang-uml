# Diagram file for Conformality
compilation_database_dir: build
output_directory: docs/diagrams
query_driver: c++
diagrams:
  conformal_map:
    type: class
    title: Conformal Map Depends
    generate_method_arguments: abbreviated
    glob:
      - src/**/*.h
      - src/**/*.cpp
    include:
      dependencies:
        - ConformalMap
      dependants:
        - ConformalMap
    exclude:
      namespaces:
        - std
    plantuml:
      before:
        - 'skinparam classAttributeIconSize 0'
        - 'skinparam classFontSize 12'
        - 'skinparam class {'
        - '  BackgroundColor White'
        - '  BorderColor Black'
        - '  ArrowColor Black'
        - '}'

  theodorsen_method:
    type: class
    title: Theodorsen's Method Classes
    generate_method_arguments: abbreviated
    glob:
      - src/**/*.h
      - src/**/*.cpp
    include:
      context:
        - match:
            radius: 4
            pattern: TheodorsenMethod
    exclude:
      namespaces:
        - std

  domains:
    type: class
    title: Available Domains
    generate_method_arguments: abbreviated
    glob:
      - src/domains/*.h
      - src/domains/*.cpp
    include:
      context:
        - match:
            radius: 4
            pattern: Domain
    exclude:
      namespaces:
        - std
      elements:
        - IStatusManager

  all_classes:
    type: class
    title: All Conformality Classes
    generate_method_arguments: abbreviated
    glob:
      - src/**/*.h
      - src/**/*.cpp
    exclude:
      namespaces:
        - std

# vim: ft=yaml
